# Copy this file to .env and fill in real values. .env is gitignored.
# These are the same Cognito App Client / User Pool created by
# infra/modules/cognito — the pool id and client id are not secret (this is a
# public client with no client secret), but keeping them in .env makes it easy
# to point the frontend at a different environment (dev/staging/prod) later.

VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-2

VITE_API_URL=http://localhost:8000
