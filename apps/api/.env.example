# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

ENVIRONMENT=local

# Local docker-compose Postgres (see docker-compose.yml at repo root)
# — or a Neon (neon.tech) connection string for local dev, in the same
# postgresql+psycopg://... shape.
DATABASE_URL=postgresql+psycopg://rephrase:rephrase@localhost:5432/rephrase

# --- Phase 1 (Auth) ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=eu-west-2

# --- Phase 3 (AI pipeline) ---
OPENAI_API_KEY=
